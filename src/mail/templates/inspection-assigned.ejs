<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Inspection Assigned</title>
  <style>
    body { margin: 0; padding: 0; background: #f5f5f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .wrap { max-width: 500px; margin: 40px auto; padding: 0 16px; }
    .card { background: #fff; border-radius: 10px; border: 1px solid #e5e7eb; overflow: hidden; }
    .top { background: #111827; padding: 28px 32px; }
    .top .brand { font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.4); letter-spacing: 1.2px; text-transform: uppercase; }
    .top h1 { font-size: 20px; font-weight: 600; color: #fff; margin: 10px 0 0; line-height: 1.4; }
    .body { padding: 28px 32px; }
    .body p { font-size: 14px; color: #6b7280; line-height: 1.7; margin: 0 0 20px; }
    .body p strong { color: #111827; }
    .info { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px 20px; margin-bottom: 24px; }
    .info .row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #f3f4f6; font-size: 13px; }
    .info .row:last-child { border-bottom: none; }
    .info .key { color: #9ca3af; }
    .info .val { color: #111827; font-weight: 600; }
    .btn { display: inline-block; background: #111827; color: #fff !important; text-decoration: none; font-size: 14px; font-weight: 600; padding: 12px 28px; border-radius: 7px; }
    .footer { border-top: 1px solid #f3f4f6; padding: 18px 32px; }
    .footer p { font-size: 12px; color: #d1d5db; margin: 0; line-height: 1.6; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="top">
        <div class="brand"><%= platformName %></div>
        <h1>You have a new inspection assigned</h1>
      </div>
      <div class="body">
        <p>Hi <strong><%= username %></strong>,</p>
        <p>An inspection has been scheduled and assigned to you by <strong><%= assignedBy %></strong>. Please review the details below.</p>
        <div class="info">
          <div class="row">
            <span class="key">Property</span>
            <span class="val"><%= propertyName %></span>
          </div>
          <% if (propertyAddress) { %>
          <div class="row">
            <span class="key">Address</span>
            <span class="val"><%= propertyAddress %></span>
          </div>
          <% } %>
          <div class="row">
            <span class="key">Scheduled Date</span>
            <span class="val"><%= scheduledAt %></span>
          </div>
        </div>
        <a href="<%= dashboardUrl %>" class="btn">View Dashboard</a>
      </div>
      <div class="footer">
        <p>&copy; <%= new Date().getFullYear() %> <%= platformName %>. This was sent because an inspection was assigned to you.</p>
      </div>
    </div>
  </div>
</body>
</html>