<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account Deactivated</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f5f5f5;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          sans-serif;
      }
      .wrap {
        max-width: 500px;
        margin: 40px auto;
        padding: 0 16px;
      }
      .card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        overflow: hidden;
      }
      .top {
        background: #1f2937;
        padding: 28px 32px;
      }
      .top .brand {
        font-size: 13px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.4);
        letter-spacing: 1.2px;
        text-transform: uppercase;
      }
      .top h1 {
        font-size: 20px;
        font-weight: 600;
        color: #fff;
        margin: 10px 0 0;
      }
      .body {
        padding: 28px 32px;
      }
      .body p {
        font-size: 14px;
        color: #6b7280;
        line-height: 1.7;
        margin: 0 0 16px;
      }
      .body p strong {
        color: #111827;
      }
      .info-box {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 14px 18px;
        font-size: 13px;
        color: #6b7280;
        line-height: 1.6;
      }
      .footer {
        border-top: 1px solid #f3f4f6;
        padding: 18px 32px;
      }
      .footer p {
        font-size: 12px;
        color: #d1d5db;
        margin: 0;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="card">
        <div class="top">
          <div class="brand"><%= platformName %></div>
          <h1>Your account has been deactivated</h1>
        </div>
        <div class="body">
          <p>Hi <strong><%= username %></strong>,</p>
          <p>
            Your account on <strong><%= platformName %></strong> has been
            deactivated by an administrator. You will no longer be able to log
            in.
          </p>
          <div class="info-box">
            If you believe this was a mistake or would like to appeal, please
            contact your administrator or reply to this email.
          </div>
        </div>
        <div class="footer">
          <p>&copy; <%= new Date().getFullYear() %> <%= platformName %>.</p>
        </div>
      </div>
    </div>
  </body>
</html>
