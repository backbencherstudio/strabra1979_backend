<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard Invitation</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #f0f2f5;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .wrap {
      max-width: 520px;
      margin: 48px auto;
      padding: 0 16px;
    }

    .card {
      background: #fff;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #e5e7eb;
    }

    .top {
      background: #111827;
      padding: 32px;
      text-align: center;
    }

    .top .brand {
      font-size: 14px;
      font-weight: 600;
      color: rgba(255,255,255,0.5);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 20px;
    }

    .top h1 {
      font-size: 20px;
      font-weight: 600;
      color: #fff;
      line-height: 1.5;
      margin: 0;
    }

    .top .from {
      font-size: 13px;
      color: rgba(255,255,255,0.45);
      margin-top: 8px;
    }

    .content {
      padding: 32px;
    }

    .content p {
      font-size: 14px;
      color: #6b7280;
      line-height: 1.7;
      margin: 0 0 24px;
    }

    .steps {
      background: #f9fafb;
      border-radius: 8px;
      padding: 20px;
      margin: 24px 0;
    }

    .steps .step {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 20px;
    }

    .steps .step:last-child {
      margin-bottom: 0;
    }

    .steps .step-number {
      background: #111827;
      color: white;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 600;
      flex-shrink: 0;
    }

    .steps .step-content {
      flex: 1;
    }

    .steps .step-title {
      font-weight: 600;
      color: #111827;
      font-size: 14px;
      margin-bottom: 4px;
    }

    .steps .step-desc {
      font-size: 13px;
      color: #6b7280;
    }

    .property {
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 16px 20px;
      margin-bottom: 28px;
    }

    .property .tag {
      font-size: 11px;
      font-weight: 600;
      color: #6366f1;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 4px;
    }

    .property .name {
      font-size: 16px;
      font-weight: 700;
      color: #111827;
    }

    .property .address {
      font-size: 13px;
      color: #9ca3af;
      margin-top: 3px;
    }

    .btn-wrap {
      text-align: center;
      margin: 4px 0 20px;
    }

    .btn {
      display: inline-block;
      background: #111827;
      color: #fff !important;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      padding: 13px 32px;
      border-radius: 8px;
    }

    .expiry {
      text-align: center;
      font-size: 12px;
      color: #d1d5db;
      margin-bottom: 24px;
    }

    .link-box {
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      padding: 12px 14px;
    }

    .link-box p {
      font-size: 12px;
      color: #9ca3af;
      margin: 0 0 4px;
    }

    .link-box span {
      font-size: 11px;
      color: #6366f1;
      word-break: break-all;
    }

    .info-note {
      background: #fef3c7;
      border-left: 3px solid #f59e0b;
      padding: 12px 16px;
      margin: 24px 0;
      border-radius: 6px;
    }

    .info-note p {
      font-size: 12px;
      color: #92400e;
      margin: 0;
    }

    .footer {
      border-top: 1px solid #f3f4f6;
      padding: 20px 32px;
      text-align: center;
    }

    .footer p {
      font-size: 12px;
      color: #d1d5db;
      line-height: 1.6;
      margin: 0;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">

      <div class="top">
        <div class="brand"><%= platformName %></div>
        <h1>You've been invited to a property dashboard</h1>
        <div class="from">from <%= inviterName %></div>
      </div>

      <div class="content">
        <p>
          <strong style="color:#111827"><%= inviterName %></strong> has given you access to the following property dashboard.
        </p>

        <div class="property">
          <div class="tag">Property</div>
          <div class="name"><%= propertyName %></div>
          <% if (propertyAddress) { %>
            <div class="address"><%= propertyAddress %></div>
          <% } %>
        </div>

        <!-- Simple Steps -->
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-content">
              <div class="step-title">Click the button below</div>
              <div class="step-desc">You'll be taken to create your account</div>
            </div>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <div class="step-content">
              <div class="step-title">Complete registration</div>
              <div class="step-desc">Choose your username and password</div>
            </div>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <div class="step-content">
              <div class="step-title">Access granted automatically</div>
              <div class="step-desc">Your property dashboard will appear immediately after login</div>
            </div>
          </div>
        </div>

        <div class="btn-wrap">
          <a href="<%= signupLink %>" class="btn">Accept & Create Account</a>
        </div>

        <p class="expiry">Invitation expires in 7 days</p>

        <!-- Auto-grant explanation -->
        <div class="info-note">
          <p>
            <strong>Good to know:</strong> When you create your account, property access is 
            automatically granted. No waiting or approval needed for this dashboard!
          </p>
        </div>

        <div class="link-box">
          <p>Button not working? Copy and paste this link:</p>
          <span><%= signupLink %></span>
        </div>
      </div>

      <div class="footer">
        <p>
          You received this because <%= inviterName %> invited you.<br/>
          If this wasn't expected, you can ignore this email.<br/>
          &copy; <%= new Date().getFullYear() %> <%= platformName %>
        </p>
      </div>

    </div>
  </div>
</body>
</html>