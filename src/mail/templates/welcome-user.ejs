<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Welcome</title>
  <style>
    body { margin: 0; padding: 0; background: #f5f5f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .wrap { max-width: 500px; margin: 40px auto; padding: 0 16px; }
    .card { background: #fff; border-radius: 10px; border: 1px solid #e5e7eb; overflow: hidden; }
    .top { background: #111827; padding: 28px 32px; }
    .top .brand { font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.4); letter-spacing: 1.2px; text-transform: uppercase; }
    .top h1 { font-size: 20px; font-weight: 600; color: #fff; margin: 10px 0 0; }
    .body { padding: 28px 32px; }
    .body p { font-size: 14px; color: #6b7280; line-height: 1.7; margin: 0 0 20px; }
    .body p strong { color: #111827; }
    .btn-wrap { margin: 24px 0; }
    .btn { display: inline-block; background: #111827; color: #fff !important; text-decoration: none; font-size: 14px; font-weight: 600; padding: 12px 28px; border-radius: 7px; }
    .footer { border-top: 1px solid #f3f4f6; padding: 18px 32px; }
    .footer p { font-size: 12px; color: #d1d5db; margin: 0; line-height: 1.6; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="top">
        <div class="brand"><%= platformName %></div>
        <h1>Welcome aboard, <%= username %> 👋</h1>
      </div>
      <div class="body">
        <p>Your account has been created successfully. <% if (requiresApproval) { %>It's currently pending admin approval — you'll receive another email once it's activated.<% } else { %>You're all set and can log in now.<% } %></p>
        <% if (!requiresApproval) { %>
        <div class="btn-wrap">
          <a href="<%= loginUrl %>" class="btn">Go to Dashboard</a>
        </div>
        <% } %>
        <p style="font-size:13px; color:#9ca3af;">
          Email: <strong><%= email %></strong><br/>
          Role: <strong><%= role %></strong>
        </p>
      </div>
      <div class="footer">
        <p>&copy; <%= new Date().getFullYear() %> <%= platformName %>. If you didn't create this account, please ignore this email.</p>
      </div>
    </div>
  </div>
</body>
</html>