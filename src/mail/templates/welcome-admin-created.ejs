<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Account is Ready</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f5f5f5;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          sans-serif;
      }
      .wrap {
        max-width: 500px;
        margin: 40px auto;
        padding: 0 16px;
      }
      .card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        overflow: hidden;
      }
      .top {
        background: #111827;
        padding: 28px 32px;
      }
      .top .brand {
        font-size: 13px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.4);
        letter-spacing: 1.2px;
        text-transform: uppercase;
      }
      .top h1 {
        font-size: 20px;
        font-weight: 600;
        color: #fff;
        margin: 10px 0 0;
      }
      .body {
        padding: 28px 32px;
      }
      .body p {
        font-size: 14px;
        color: #6b7280;
        line-height: 1.7;
        margin: 0 0 20px;
      }
      .creds {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 16px 20px;
        margin: 4px 0 24px;
      }
      .creds .row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        border-bottom: 1px solid #f3f4f6;
      }
      .creds .row:last-child {
        border-bottom: none;
      }
      .creds .key {
        font-size: 12px;
        color: #9ca3af;
        font-weight: 500;
      }
      .creds .val {
        font-size: 13px;
        color: #111827;
        font-weight: 600;
        font-family: monospace;
      }
      .btn-wrap {
        margin: 24px 0;
      }
      .btn {
        display: inline-block;
        background: #111827;
        color: #fff !important;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        padding: 12px 28px;
        border-radius: 7px;
      }
      .notice {
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 7px;
        padding: 12px 16px;
        font-size: 13px;
        color: #92400e;
        margin-top: 4px;
      }
      .footer {
        border-top: 1px solid #f3f4f6;
        padding: 18px 32px;
      }
      .footer p {
        font-size: 12px;
        color: #d1d5db;
        margin: 0;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="card">
        <div class="top">
          <div class="brand"><%= platformName %></div>
          <h1>Your account is ready, <%= username %></h1>
        </div>
        <div class="body">
          <p>
            An account has been created for you on
            <strong><%= platformName %></strong>. Here are your login
            credentials:
          </p>

          <div class="creds">
            <div class="row">
              <span class="key">Email</span>
              <span class="val"><%= email %></span>
            </div>
            <div class="row">
              <span class="key">Password</span>
              <span class="val"><%= tempPassword %></span>
            </div>
            <div class="row">
              <span class="key">Role</span>
              <span class="val"><%= role %></span>
            </div>
          </div>

          <div class="notice">
            🔒 Please change your password after your first login.
          </div>

          <div class="btn-wrap" style="margin-top: 24px">
            <a href="<%= loginUrl %>" class="btn">Log In Now</a>
          </div>
        </div>
        <div class="footer">
          <p>
            &copy; <%= new Date().getFullYear() %> <%= platformName %>. This
            email was sent by an administrator.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
