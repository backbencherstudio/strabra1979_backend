<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard Assigned</title>
  <style>
    body { margin: 0; padding: 0; background: #f5f5f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .wrap { max-width: 500px; margin: 40px auto; padding: 0 16px; }
    .card { background: #fff; border-radius: 10px; border: 1px solid #e5e7eb; overflow: hidden; }
    .top { background: #111827; padding: 28px 32px; }
    .top .brand { font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.4); letter-spacing: 1.2px; text-transform: uppercase; }
    .top h1 { font-size: 20px; font-weight: 600; color: #fff; margin: 10px 0 0; line-height: 1.4; }
    .body { padding: 28px 32px; }
    .body p { font-size: 14px; color: #6b7280; line-height: 1.7; margin: 0 0 20px; }
    .body p strong { color: #111827; }
    .property { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px 20px; margin-bottom: 24px; }
    .property .tag { font-size: 11px; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px; }
    .property .name { font-size: 16px; font-weight: 700; color: #111827; }
    .property .address { font-size: 13px; color: #9ca3af; margin-top: 3px; }
    .btn { display: inline-block; background: #111827; color: #fff !important; text-decoration: none; font-size: 14px; font-weight: 600; padding: 12px 28px; border-radius: 7px; }
    .footer { border-top: 1px solid #f3f4f6; padding: 18px 32px; }
    .footer p { font-size: 12px; color: #d1d5db; margin: 0; line-height: 1.6; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="top">
        <div class="brand"><%= platformName %></div>
        <h1>You've been assigned to a property</h1>
      </div>
      <div class="body">
        <p>Hi <strong><%= username %></strong>,</p>
        <p>You have been assigned as the <strong>Property Manager</strong> for the following property by <strong><%= assignedBy %></strong>.</p>
        <div class="property">
          <div class="tag">Property</div>
          <div class="name"><%= propertyName %></div>
          <% if (propertyAddress) { %>
            <div class="address"><%= propertyAddress %></div>
          <% } %>
        </div>
        <p>You now have full management access to this property dashboard.</p>
        <a href="<%= dashboardUrl %>" class="btn">View Dashboard</a>
      </div>
      <div class="footer">
        <p>&copy; <%= new Date().getFullYear() %> <%= platformName %>. This was sent because an admin assigned you to a property.</p>
      </div>
    </div>
  </div>
</body>
</html>